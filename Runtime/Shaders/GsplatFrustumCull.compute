struct SpatialNode
{
    float4 centerMin;
    float4 centerMax;
    float4 footprintMin;
    float4 footprintMax;
};

struct LodNode
{
    SpatialNode bounds;
    float4 metrics;
    uint firstChild;
    uint childCount;
    uint firstSplat;
    uint splatCount;
    uint firstRepresentative;
    uint representativeCount;
    uint level;
    uint padding;
};

struct LodSplat
{
    float4 positionOpacity;
    float4 scaleContribution;
    float4 rotation;
    float4 color;
};

